' ================================================================================
' DIAGRAMA 19: PROCESO BPM - Detección de Señas
' ================================================================================

@startuml Proceso_BPM_Deteccion

title Proceso de Negocio (BPM) - Detección y Traducción de Señas

|Usuario|
start
:Abrir aplicación;
:Click "Iniciar Detección";

|Sistema|
:Inicializar cámara;
:Cargar dataset de señas;
:Iniciar MediaPipe;

repeat
    |Sistema|
    :Capturar frame de video;
    :Procesar con MediaPipe;
    
    if (¿Mano detectada?) then (Sí)
        :Extraer landmarks\n(21 puntos);
        :Calcular features\n(17 características);
        :Clasificar con 4 métricas;
        :Aplicar suavizado temporal;
        
        if (¿Confianza > 0.6?) then (Sí)
            :Verificar cooldown;
            
            if (¿Cooldown OK?) then (Sí)
                :Agregar a historial;
                :Actualizar estadísticas;
                
                |Usuario|
                :Ver traducción en pantalla;
                
                if (¿Usuario solicita TTS?) then (Sí)
                    |Sistema|
                    :Generar audio con gTTS;
                    :Reproducir con pygame;
                    
                    |Usuario|
                    :Escuchar pronunciación;
                else (No)
                endif
            else (No - Duplicado)
                :Ignorar detección;
            endif
        else (No - Baja confianza)
            :Continuar captura;
        endif
    else (No)
        :Mostrar "Esperando mano...";
    endif
    
repeat while (¿Continuar detección?) is (Sí)
->No;

|Usuario|
:Click "Detener";

|Sistema|
:Cerrar ventana de video;
:Liberar cámara;
:Guardar historial (opcional);

|Usuario|
if (¿Exportar historial?) then (Sí)
    |Sistema|
    :Generar archivo TXT;
    :Guardar con timestamp;
    
    |Usuario|
    :Recibir archivo exportado;
else (No)
endif

stop

@enduml

