' DIAGRAMA 11: ARQUITECTURA MVC
' ================================================================================

@startuml Arquitectura_MVC

title Arquitectura MVC del Sistema

package "Model" {
    class PeruvianSignsDataset {
        + signs_data
        + load_dataset()
        + save_dataset()
        + add_sign()
        + get_all_signs()
    }
    
    class TranslationHistory {
        + history: List
        + max_size: int
        + add(entry)
        + clear()
        + export()
    }
    
    class SignModel {
        + name: str
        + features: ndarray
        + confidence: float
        + timestamp: float
    }
}

package "View" {
    class TkinterGUI {
        + root: Tk
        + header_frame
        + main_content_frame
        + history_panel
        + training_panel
        + stats_panel
        + controls_frame
        + render()
        + update_display()
    }
    
    class HistoryView {
        + listbox: Listbox
        + scrollbar
        + update(history)
        + clear()
    }
    
    class StatsView {
        + labels: Dict
        + update(stats)
    }
}

package "Controller" {
    class HandDetectionApp {
        + model: PeruvianSignsDataset
        + view: TkinterGUI
        + detector: HandDetector
        + handle_start_detection()
        + handle_stop_detection()
        + handle_sign_detected()
        + handle_export()
        + update_view()
    }
    
    class DetectionController {
        + detector: HandDetector
        + start()
        + stop()
        + on_detection_callback()
    }
}

' Relaciones MVC
HandDetectionApp --> PeruvianSignsDataset : usa
HandDetectionApp --> TranslationHistory : gestiona
HandDetectionApp --> TkinterGUI : controla
HandDetectionApp --> DetectionController : coordina

TkinterGUI --> HistoryView : contiene
TkinterGUI --> StatsView : contiene

DetectionController --> SignModel : crea

HistoryView --> TranslationHistory : visualiza

note right of HandDetectionApp
    Controlador principal
    Coordina Model y View
end note

note right of PeruvianSignsDataset
    Modelo de datos
    Persistencia en JSON
end note

note right of TkinterGUI
    Vista principal
    Interfaz Tkinter
end note

@enduml

