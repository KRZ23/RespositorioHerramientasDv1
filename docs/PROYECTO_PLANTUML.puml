@startuml Diagrama_Entidad_Relacion

title Diagrama Entidad-Relación - Modelo de Datos

' Entidades
entity "Sign" as Sign {
    * sign_id : String <<PK>>
    --
    * name : String
    * description : String
    * features_vector : Array[float]
    * fingers_extended : Array[bool]
    * hand_openness : float
    * confidence_threshold : float
    trained_samples : int
    last_updated : DateTime
    created_at : DateTime
}

entity "TranslationEntry" as Translation {
    * entry_id : int <<PK>>
    --
    * sign_id : String <<FK>>
    * timestamp : float
    * confidence : float
    * datetime : String
    session_id : String
}

entity "Session" as Session {
    * session_id : String <<PK>>
    --
    * start_time : DateTime
    end_time : DateTime
    * total_detections : int
    * successful_translations : int
    * precision : float
    configuration : JSON
}

entity "UserConfiguration" as Config {
    * config_id : int <<PK>>
    --
    * sign_cooldown : float
    * confidence_threshold : float
    * max_history : int
    * tts_enabled : bool
    camera_index : int
    language : String
    updated_at : DateTime
}

entity "FeatureVector" as Feature {
    * feature_id : int <<PK>>
    --
    * sign_id : String <<FK>>
    * finger_distances : Array[float, 5]
    * finger_angles : Array[float, 5]
    * finger_states : Array[bool, 5]
    * hand_openness : float
    * orientation : float
}

entity "DetectionLog" as Log {
    * log_id : int <<PK>>
    --
    * session_id : String <<FK>>
    * timestamp : float
    * frame_number : int
    detected_sign : String
    confidence : float
    processing_time : float
    fps : float
}

' Relaciones
Sign ||--o{ Translation : "detectada en"
Sign ||--|| Feature : "tiene"
Session ||--o{ Translation : "contiene"
Session ||--o{ Log : "registra"
Config ||--o| Session : "configura"

note right of Sign
    **Entidad principal**
    Almacena patrones de señas LSP
    Dataset extensible
end note

note right of Translation
    **Historial de traducciones**
    Máximo 100 entradas por sesión
    Cooldown aplicado
end note

note right of Session
    **Sesión de usuario**
    Tracking de estadísticas
    Análisis de rendimiento
end note

@enduml

