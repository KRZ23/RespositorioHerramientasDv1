@startuml Traductor_Señas_Peruano_Completo

' ================================================================================
' TRADUCTOR DE SEÑAS PERUANO - VERSIÓN 2.1
' DIAGRAMAS PLANTUML COMPLETOS
' ================================================================================
' Fecha: 20 de Octubre 2025
' Repositorio: RespositorioHerramientasDv1
' Propietario: KRZ23
' Rama: CristopherRivera
' ================================================================================

title Traductor de Señas Peruano v2.1 - Diagrama de Clases

' ================================================================================
' DIAGRAMA 1: DIAGRAMA DE CLASES PRINCIPAL
' ================================================================================

package "GUI Layer" {
    class HandDetectionApp {
        - root: tkinter.Tk
        - hand_detector: HandDetector
        - translation_history: List[Dict]
        - last_sign_detected: str
        - last_sign_time: float
        - sign_cooldown: float
        - detection_count: int
        - successful_translations: int
        - tts_available: bool
        - colors: Dict[str, str]
        
        + __init__(root)
        + create_interface()
        + create_header()
        + create_main_content()
        + create_history_panel()
        + create_training_panel()
        + create_stats_panel()
        + create_controls()
        + add_to_history(sign_name, confidence, timestamp)
        + update_history_display()
        + speak_text(text)
        + speak_selected()
        + speak_all()
        + clear_history()
        + export_history()
        + update_cooldown(value)
        + start_detection()
        + stop_detection()
        + train_new_sign()
        + update_stats()
        + on_hand_detected(hand_landmarks)
        + on_sign_detected(sign_name, confidence)
        + update_text(message)
    }
}

package "Detection Layer" {
    class HandDetector {
        - mp_hands: mediapipe.solutions.hands
        - hands: mediapipe.solutions.hands.Hands
        - mp_draw: mediapipe.solutions.drawing_utils
        - is_detecting: bool
        - cap: cv2.VideoCapture
        - detection_thread: threading.Thread
        - window_created: bool
        - sign_classifier: SignClassifier
        - translation_enabled: bool
        - on_hand_detected_callback: Callable
        - on_status_update_callback: Callable
        - on_error_callback: Callable
        - on_sign_detected_callback: Callable
        
        + __init__()
        + set_callbacks(on_hand_detected, on_status_update, on_error, on_sign_detected)
        + start_detection()
        + stop_detection()
        + enable_translation()
        + disable_translation()
        - _detection_loop()
        - _process_frame(frame)
        - _draw_hand_landmarks(frame, hand_landmarks)
    }
}

package "Classification Layer" {
    class SignClassifier {
        - feature_extractor: SignFeatureExtractor
        - dataset: PeruvianSignsDataset
        - confidence_threshold: float
        - prediction_history: List[Tuple]
        - history_size: int
        - stable_frames: int
        - classification_metrics: Dict[str, Callable]
        - metric_weights: Dict[str, float]
        
        + __init__(confidence_threshold)
        + classify_hand_landmarks(hand_landmarks)
        + set_confidence_threshold(threshold)
        - _smooth_prediction(sign, confidence)
        - _calculate_combined_confidence(features, sign_data)
        - _cosine_similarity(vec1, vec2)
        - _euclidean_similarity(vec1, vec2)
        - _correlation_similarity(vec1, vec2)
        - _basic_pattern_match(features, pattern)
    }
    
    class SignFeatureExtractor {
        - WRIST: int = 0
        - THUMB_TIP: int = 4
        - INDEX_TIP: int = 8
        - MIDDLE_TIP: int = 12
        - RING_TIP: int = 16
        - PINKY_TIP: int = 20
        - THUMB_IP: int = 3
        - INDEX_PIP: int = 6
        - MIDDLE_PIP: int = 10
        - RING_PIP: int = 14
        - PINKY_PIP: int = 18
        
        + __init__()
        + extract_features(hand_landmarks)
        - _calculate_distance(point1, point2)
        - _calculate_angle(point1, point2, point3)
        - _fingers_extended(points)
        - _hand_openness(points)
    }
}

package "Data Layer" {
    class PeruvianSignsDataset {
        - dataset_file: str
        - signs_data: Dict[str, Dict]
        - basic_signs: Dict[str, Dict]
        
        + __init__(dataset_file)
        + load_dataset()
        + save_dataset()
        + add_sign(name, features, description)
        + get_all_signs()
        + get_sign(name)
        - _initialize_basic_signs()
    }
}

package "External Libraries" {
    class MediaPipe <<external>> {
        + Hands
        + HandLandmark
        + solutions.hands
        + solutions.drawing_utils
    }
    
    class OpenCV <<external>> {
        + VideoCapture
        + imread()
        + imshow()
        + cvtColor()
        + rectangle()
        + putText()
    }
    
    class gTTS <<external>> {
        + gTTS(text, lang)
        + save(filename)
    }
    
    class Pygame <<external>> {
        + mixer.init()
        + mixer.music.load()
        + mixer.music.play()
    }
}

' Relaciones entre clases
HandDetectionApp --> HandDetector : usa
HandDetector --> SignClassifier : usa
SignClassifier --> SignFeatureExtractor : usa
SignClassifier --> PeruvianSignsDataset : usa
HandDetector --> MediaPipe : usa
HandDetector --> OpenCV : usa
HandDetectionApp --> gTTS : usa
HandDetectionApp --> Pygame : usa

@enduml

' ================================================================================
' DIAGRAMA 2: DIAGRAMA DE SECUENCIA - FLUJO DE DETECCIÓN
' ================================================================================

@startuml Flujo_Deteccion_Señas

title Flujo de Detección de Señas

actor Usuario
participant "HandDetectionApp" as App
participant "HandDetector" as Detector
participant "MediaPipe" as MP
participant "SignClassifier" as Classifier
participant "SignFeatureExtractor" as Extractor
participant "PeruvianSignsDataset" as Dataset
database "translation_history" as History

Usuario -> App: Click "Iniciar Detección"
activate App

App -> Detector: start_detection()
activate Detector

Detector -> Detector: _detection_loop()
note right: Thread separado

loop Cada frame de video
    Detector -> MP: process(frame)
    activate MP
    MP --> Detector: hand_landmarks
    deactivate MP
    
    alt Mano detectada
        Detector -> Classifier: classify_hand_landmarks(landmarks)
        activate Classifier
        
        Classifier -> Extractor: extract_features(landmarks)
        activate Extractor
        Extractor --> Classifier: features_vector (17 elementos)
        deactivate Extractor
        
        Classifier -> Dataset: get_all_signs()
        activate Dataset
        Dataset --> Classifier: signs_data
        deactivate Dataset
        
        loop Para cada seña en dataset
            Classifier -> Classifier: _cosine_similarity()
            Classifier -> Classifier: _euclidean_similarity()
            Classifier -> Classifier: _correlation_similarity()
            Classifier -> Classifier: _basic_pattern_match()
            Classifier -> Classifier: _calculate_combined_confidence()
        end
        
        Classifier -> Classifier: _smooth_prediction()
        note right: Suavizado temporal\n5 frames, 3 consistentes
        
        alt Confianza > 0.6
            Classifier --> Detector: (sign_name, confidence)
            Detector -> App: on_sign_detected(sign_name, confidence)
            
            App -> App: add_to_history()
            note right: Verificar cooldown
            
            alt Cooldown OK
                App -> History: Agregar entrada
                App -> App: update_history_display()
                App -> App: update_stats()
                App --> Usuario: Mostrar traducción
            else Dentro de cooldown
                App -> App: Ignorar duplicado
            end
        else Confianza < 0.6
            Classifier --> Detector: (None, 0.0)
        end
        
        deactivate Classifier
    end
end

Usuario -> App: Click "Detener"
App -> Detector: stop_detection()
deactivate Detector
deactivate App

@enduml

' ================================================================================
' DIAGRAMA 3: DIAGRAMA DE ACTIVIDADES - SISTEMA DE COOLDOWN
' ================================================================================

@startuml Sistema_Cooldown

title Sistema de Cooldown Anti-Duplicados

start

:Nueva seña detectada;
:Obtener current_time;

if (last_sign_detected == sign_name?) then (Sí)
    :Calcular tiempo_transcurrido\n= current_time - last_sign_time;
    
    if (tiempo_transcurrido < sign_cooldown?) then (Sí - Dentro de cooldown)
        :Ignorar duplicado;
        note right
            Evita agregar la misma 
            seña múltiples veces
            en corto tiempo
        end note
        stop
    else (No - Cooldown pasado)
        :Continuar procesamiento;
    endif
else (No - Seña diferente)
    :Continuar procesamiento;
    note right
        Señas diferentes se 
        agregan inmediatamente
    end note
endif

:Crear entrada de historial;
:entry = {
    id, timestamp, 
    sign, confidence, 
    datetime
};

:Agregar a translation_history;

if (len(translation_history) > 100?) then (Sí)
    :Eliminar entrada más antigua;
else (No)
endif

:Actualizar last_sign_detected = sign_name;
:Actualizar last_sign_time = current_time;
:update_history_display();

stop

@enduml

